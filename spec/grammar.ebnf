(*
 * grammar.ebnf — NodeCoda Language Grammar (single source of truth)
 *
 * Authority: nodecoda/nodecoda-spec is the canonical specification home for
 * the NodeCoda language. THIS FILE is the machine-readable grammar of record;
 * docs/user/LANGUAGE-REFERENCE.md §11 is its production-name index, and
 * spec/examples/nodecoda/ is its example corpus.
 *
 * Provenance: translated 2026-08-23 from `dify-dsl.y` (Yacc-shaped reference
 * grammar formerly at nodecoda-lang/lang/docs/dify-dsl.y and
 * ncoda-py/docs/dify-dsl.y). Those files are RETIRED; do not edit or restore
 * them. The executable parsers (godcc internal/parser, ncoda-lang parser.py)
 * are implementations of THIS grammar, not independent authorities.
 *
 * Maintenance rules:
 *   1. Grammar change → edit THIS file + §11 facts index + LANGUAGE-REFERENCE
 *      prose + examples, in one change set.
 *   2. Production names are stable identifiers; renaming requires updating
 *      the §11 index (id = syntax.<name>) and any tooling that consumes facts.
 *   3. Semantic restrictions that cannot be expressed in EBNF are listed in
 *      "Static semantic restrictions" below and are part of the contract.
 *
 * Reconciliation ledger (vs retired dify-dsl.y):
 *   removed  : dead reserved tokens entry / stream / |> (A1 cleanup, godcc)
 *              parallel_expr (value form removed; see LANGUAGE-REFERENCE §5.4)
 *              agent(...) operation-call form (superseded by @agent decl)
 *              datasource(...) reserved operation (target-specific)
 *              answer_stmt + reserved token answer (2026-08-23; its
 *                  intermediate-publish semantics folded into output(expr);
 *                  its @answer decl successor was itself removed 2026-09-16 —
 *                  see the W1 ledger entry below)
 *              output(key, value) key form (single-value output(expr))
 *              answer_decl (@answer) + the KEYWORD binding-name position and
 *                  the `word` production — REMOVED 2026-09-16 (W1 ruling D4):
 *                  `answer` is a Dify-era construct. On the platform the
 *                  useAnswerContent exit endpoint IS an OutputEmitter at
 *                  runtime (the same object an output node is), but that is a
 *                  PLATFORM fact — not a licence to carry that endpoint with the
 *                  output construct. The endpoint decides the flow's ANSWER
 *                  VALUE and is carried by `return template ...` (W1 D6 / W2),
 *                  while output(...) is the intermediate-message statement.
 *                  Ruling record (godcc):
 *                  docs/five-step/spec/W1-output-return.md
 *   added    : import_decl (LANGUAGE-REFERENCE §1.3, godcc import)
 *              agent_application / agent_block (§1.5, godcc @agent)
 *              answer_decl (@answer final-answer template, distinct from the
 *                           removed answer_stmt) — REMOVED 2026-09-16 (W1 D4;
 *                           see the removal entry below)
 *              @language / @mode declarations (already in §11 facts)
 *   added    : ask_stmt / switch_stmt / subflow_decl (2026-08-31, godcc ask/switch/subflow)
 *              parallel_for_stmt (2026-09-14, godcc — statement-level side-effect
 *                  parallel loop; the iteration-scope contract lives in
 *                  LANGUAGE-REFERENCE §5.4)
 *   added    : ?? null-coalescing operator (coalesce_expr), 2026-09-16 — was
 *                  implementation-only (godcc); `int(...)` / `file(...)`
 *                  contextual conversions (cast_expr) and the `$` identifier
 *                  escape (ESCAPED_IDENTIFIER) land in the same change set:
 *                  all three were carried by the implementation as undeclared
 *                  quirks (godcc G13) and by raising output before that;
 *              param_list / param / return_type_opt / KEYWORD — previously
 *                  referenced but never defined in this file (grammar defect,
 *                  2026-09-16); postfix member position widened from
 *                  `( IDENTIFIER | "type" )` to any contextual word, because
 *                  platform ports are named with reserved words.
 *   added    : name / member_name (2026-09-16, W1 ruling D1) — ONE rule for
 *                  every name position: `name = IDENTIFIER |
 *                  ESCAPED_IDENTIFIER` (the `$` escape was documented as legal
 *                  at every name position, but the productions still spelled
 *                  plain IDENTIFIER, so the rule was unenforceable);
 *                  `member_name = name | KEYWORD` applies only where the
 *                  OUTSIDE world owns the name (postfix `.` member, `yield`
 *                  port). ESCAPED_IDENTIFIER also becomes a primary_expr.
 *   added    : template_return / template_binding_list / template_binding /
 *                  value_path (2026-09-17, W2, user ruling) — the flow's
 *                  ANSWER endpoint construct: `return template "<verbatim>"
 *                  [ using { slot: path, ... } ];`. The template operand is a
 *                  STRING_LITERAL (the target wire slot carries literals only:
 *                  63/63 answer endpoints, 265/265 output nodes) and is
 *                  carried VERBATIM with zero compiler parsing; slot names are
 *                  TARGET names (wire `node_inputs[].name`), so they use
 *                  member_name and reserved words are legal there; slot values
 *                  are value paths. `template` / `using` are CONTEXTUAL words,
 *                  not reserved. Ruling record (godcc):
 *                  docs/five-step/spec/W2-template-return.md
 *)

(* ── Terminals ──────────────────────────────────────────────────────────── *)
(*
 * Keywords (reserved; cannot be identifiers):
 *   function if else for while in return var let const output type enum
 *   parallel break continue code foreign source yield limit attempt
 *   success failure with retry timeout default as ask action import switch subflow
 *   (aliases: request_input -> ask, intent -> switch — both still reserved)
 *   true false null
 *   string int float bool file void map array any object
 *   @language @mode @conversation @agent
 *
 * Literals:
 *   STRING_LITERAL      "..." or '...' with escapes
 *   TEMPLATE_STRING     `...` with ${expression} interpolation
 *   INT_LITERAL         decimal digits
 *   FLOAT_LITERAL       digits "." digits
 *   IDENTIFIER          [_a-zA-Z][_a-zA-Z0-9]*
 *   ESCAPED_IDENTIFIER  "$" IDENTIFIER — the same name written with a leading
 *                       `$` escape (`$type` / `$file`), used when the spelled
 *                       name collides with a reserved word or a type name. The
 *                       leading `$` is not part of the name; `$` followed by
 *                       anything other than a letter or `_` is a lexical
 *                       error. The escape is a purely lexical rule and is
 *                       accepted at every name position.
 *   KEYWORD             any reserved word from the Keywords list above (type
 *                       names included); legal only where the grammar accepts
 *                       KEYWORD — i.e. `member_name` (member position after
 *                       `.`, the `yield` port name, the `template` binding
 *                       slot name), where the spelling is owned by the target
 *                       platform, not by the author.
 *
 * Symbols:
 *   ( ) { } [ ] , : ; ? ?? . -> | = == != < <= > >= && || ! + - * / %
 *   += -= *= /= <<
 *
 * Comments: // line comments; /* *\/ nested block comments.
 * Whitespace is insignificant; statements are terminated by ';' or a block.
 * Contextual words (NOT reserved: they stay ordinary identifiers and read as a
 * marker only in a fixed position): template / using, recognised only as
 * `return` + `template` + STRING_LITERAL (see template_return). `template` is
 * therefore still a legal variable name, and `return template;` still returns
 * it.
 *)

(* ── Names (one rule for every name position) ───────────────────────────── *)

name        = IDENTIFIER | ESCAPED_IDENTIFIER ;
              (* Author-chosen names. `$` spells a name that collides with a
                 reserved word or a type name; the `$` is not part of the name
                 (`$type` == "type"). Legal at EVERY name position:
                 declaration names, parameters, record fields and literal keys,
                 local names, expression references. *)
member_name = name | KEYWORD ;
              (* Target-owned names: postfix member after `.`, `yield` port,
                 `template` binding slot name. Reserved words are legal here
                 because the spelling comes from the platform (physical port /
                 field names). *)

(* ── Program structure ──────────────────────────────────────────────────── *)

program = language_decl_opt mode_decl_opt conversation_decl_list top_level_list ;

language_decl_opt = [ "@language" IDENTIFIER semicolon_opt ] ;
mode_decl_opt     = [ "@mode" IDENTIFIER semicolon_opt ] ;

conversation_decl_list = { conversation_decl } ;
conversation_decl = "@conversation" type_ref name [ "=" expression ] ";" ;

top_level_list = { top_level_decl semicolon_opt } ;
top_level_decl = const_decl | type_decl | enum_decl | import_decl | subflow_decl
               | code_function_def | function_def
               | agent_application ;

import_decl   = "import" STRING_LITERAL ";" ;
const_decl    = "const" name "=" const_value ";" ;
const_value   = STRING_LITERAL | TEMPLATE_STRING | INT_LITERAL | FLOAT_LITERAL
              | "true" | "false" | "null" ;
type_decl     = "type" name "=" "{" field_list "}" semicolon_opt ;
field_list    = { type_ref name ";" } ;
enum_decl     = "enum" name "{" enum_member_list trailing_comma_opt "}" semicolon_opt ;
enum_member_list = name { "," name } ;

param_list     = "(" [ param_seq ] ")" ;
param_seq      = param { "," param } ;
param          = type_ref name [ "=" expression ] ;
return_type_opt = [ "->" type_ref ] ;

function_def      = "function" name param_list return_type_opt block ;
code_function_def = "code" name param_list "->" type_ref block ;

agent_application = "@agent" agent_block ;
agent_block = "{" [ agent_entry { "," agent_entry } [ "," ] ] "}" ;
agent_entry = (name | STRING_LITERAL) ":" expression ;

(* ── Types ──────────────────────────────────────────────────────────────── *)

type_ref = type_atom { "[" "]" } [ "?" ] ;   (* array_suffix_seq + optional_suffix *)

type_atom = primitive_type
          | file_type_ref
          | IDENTIFIER                       (* named record / enum type *)
          | "array" "<" type_ref ">"
          | "map" "<" "string" "," type_ref ">" ;

primitive_type = "string" | "int" | "float" | "bool" | "void" | "any" | "object" ;

file_type_ref = "file" [ "<"
                         file_type_list
                         [ ";" file_extension_list ]
                         [ ";" file_upload_list ]
                       ">" ] ;
file_type_list    = name { "," name } ;
                     (* `file<…>` 的族标签：**闭集词汇表**（枚举成员，不是待解析的名字）
                        + `$` 转义。转义不是可选项而是必需 —— 关键字族（`code`）在源码里
                        唯一合法拼写是 `$code`（2026-09-21 用户拍板 A：闭集与平台名册
                        同构，共 12 个 token）。裸 `file<code>` 是语法错误（KW_CODE）。
                        该位置不参与名字解析（0 绑定点、0 作用域）：词法上是标识符，
                        语义上是枚举标签 —— 合法性由闭集判定，不由语法判定。 *)
file_extension_list = "." IDENTIFIER { "," "." IDENTIFIER } ;
file_upload_list  = IDENTIFIER { "," IDENTIFIER } ;

(* ── Statements ─────────────────────────────────────────────────────────── *)

block    = "{" stmt_list "}" ;
stmt_list = { statement } ;

statement = if_stmt | for_stmt | while_stmt | return_stmt | yield_stmt
          | parallel_stmt | parallel_for_stmt | attempt_stmt | ask_stmt | switch_stmt
          | break_stmt | continue_stmt | typed_var_decl | var_decl
          | output_stmt | expr_or_assign_stmt ;

if_stmt        = "if" "(" expression ")" block else_clause_opt ;
else_clause_opt = [ "else" ( block | if_stmt ) ] ;

for_stmt = "for" "(" for_var "in" expression ")" block ;
for_var  = name | "var" name | "let" name | type_ref name ;

while_stmt = "while" "(" expression ")" "limit" INT_LITERAL block ;

return_stmt = "return" [ expression ] ";" ;
              (* the other return shape is template_return below. *)

template_return = "return" "template" STRING_LITERAL
                  [ "using" template_binding_list ] ";" ;
              (* flow ANSWER endpoint (target `terminatePlan:
                 useAnswerContent`). The template operand is a STRING_LITERAL
                 and is carried VERBATIM: the compiler does not read it
                 (`{{a.b}}` / `{{img[0]}}` are the target's runtime template
                 language, not ncoda expressions) and never relates its
                 placeholders to the binding names. `template` is a CONTEXTUAL
                 word — the marker is recognised only as `return` + `template`
                 + STRING_LITERAL, so `return template;` still returns the
                 variable named `template`. `using` is optional (no named
                 slots); `template` is not — it is the marker that separates
                 this exit from the value exit. *)
template_binding_list = "{" [ template_binding { "," template_binding } [ "," ] ] "}" ;
template_binding = member_name ":" value_path ;
              (* Ordered slot table: source order == the target's
                 `node_inputs` order, carried verbatim (never reordered,
                 de-duplicated or filtered). The slot name is the TARGET's name
                 (wire `node_inputs[].name`), so a reserved word is legal — a
                 platform port is commonly named `output`. Duplicate slot names
                 are rejected (E1000). *)
value_path = name { "." member_name } ;
              (* slot values are value paths (exactly one producer port); the
                 target slot carries `input.value: {path, ref_node}`, so any
                 other expression shape is E1060. *)

yield_stmt  = "yield" [ member_name "=" ] [ expression ] ";" ;

parallel_stmt = "parallel" "{" { [ name ":" ] block } "}" ;

parallel_for_stmt = "parallel" "for" "(" for_var "in" expression
                    "," "concurrency" ":" INT_LITERAL
                    "," "on_error" ":" IDENTIFIER ")" block ;
                    (* 语句形态：副作用并发循环，体是普通 block（无 yield）；
                       迭代体作用域契约（迭代局部写 / 逃逸读 E1036 / 控制转移
                       E1037）见 LANGUAGE-REFERENCE §5.4。*)

attempt_stmt = "attempt" expression "as" name
               "{" "success" block "failure" "(" name ")" block "}" ;

ask_stmt = "ask" "<" type_ref "," type_ref ">"
          "(" map_literal ")" "as" name
          "{" { "action" expression block } [ "timeout" block ] "}" ;
          (* "request_input" 保留为兼容别名（godcc KW_REQUEST_INPUT 双关键字）。 *)

switch_stmt = "switch" "(" expression [ "," map_literal ] ")"
              [ "->" name ]
              "{" { STRING_LITERAL ":" block } [ "default" ":" block ] "}" ;
              (* 多出口 LLM 分类：case 标签 = 分类类别（顺序 = branch_0..N）；
                 "intent" 保留为废弃别名（godcc KW_INTENT）。*)

subflow_decl = "subflow" name "="
               "(" STRING_LITERAL "," STRING_LITERAL ")"
               "{" subflow_contract_list "}" ;
subflow_contract_list = { subflow_contract [ "," ] } ;
subflow_contract = ( "input" | "output" ) ":" "{" field_list "}" ;
              (* 子工作流声明：身份 = (workflowId, workflowVersion)；
                 input/output 契约 = 静态完整的 record 形状。 *)

break_stmt    = "break" ";" ;
continue_stmt = "continue" ";" ;

typed_var_decl = type_ref name [ "=" expression ] ";" ;
var_decl       = ( "var" | "let" ) name [ "=" expression ] ";" ;

output_stmt = "output" "(" expression ")" ";" ;  (* intermediate message *)
              (* emitted to the response stream; non-terminating *)
              (* model: docs/NCODA-OUTPUT-MODEL.md *)

expr_or_assign_stmt = expression [ ( "=" | "+=" | "-=" | "*=" | "/=" | "<<" ) expression ] ";" ;

(* ── Expressions ────────────────────────────────────────────────────────── *)

expression = ternary_expr ;
ternary_expr = coalesce_expr [ "?" expression ":" expression ] ;
coalesce_expr = or_expr { "??" or_expr } ;
              (* first non-null value selection; may not be mixed with || / &&
                 in one unparenthesized expression (static restriction below) *)
or_expr  = and_expr { "||" and_expr } ;
and_expr = equality_expr { "&&" equality_expr } ;
equality_expr = comparison_expr { ( "==" | "!=" ) comparison_expr } ;
comparison_expr = add_expr { ( "<" | "<=" | ">" | ">=" | "in" ) add_expr } ;
add_expr = multiply_expr { ( "+" | "-" ) multiply_expr } ;
multiply_expr = unary_expr { ( "*" | "/" | "%" ) unary_expr } ;
unary_expr = ( "!" | "-" ) unary_expr | postfix_expr ;

postfix_expr = primary_expr
               { "." member_name
               | "[" expression "]"
               | "<" type_ref { "," type_ref } ">" "(" arg_list ")"
               | "(" arg_list ")" }
               [ "with" operation_policies ] ;

operation_policies = operation_policy { "," operation_policy } ;
operation_policy = "retry" "(" "max" ":" INT_LITERAL
                          [ "," "interval" ":" duration ] ")"
                 | "timeout" "(" duration ")"
                 | "default" "(" expression ")" ;
duration = INT_LITERAL IDENTIFIER ;      (* unit restricted to ms | s *)

arg_list = [ arg_seq ] ;
arg_seq  = expression { "," expression } ;

primary_expr = INT_LITERAL | FLOAT_LITERAL | STRING_LITERAL | TEMPLATE_STRING
             | "true" | "false" | "null"
             | name
             | cast_expr
             | "(" expression ")"
             | array_literal | map_literal
             | for_expr | parallel_for_expr
             | foreign_code_expr | lambda_expr ;

cast_expr = "int" "(" expression ")" | "file" "(" expression ")" ;
              (* the only two builtin conversions spelled as a type keyword; the
                 keyword reads as a callee only immediately before "(" (type
                 positions never reach primary_expr, so no ambiguity).
                 `int` = numeric conversion (string/float/int → int);
                 `file` = string → file annotation. No other type keyword may
                 be used as a callee. *)

array_literal = "[" [ arg_seq ] "]" ;
map_literal   = "{" [ map_entry { "," map_entry } [ "," ] ] "}" ;
map_entry     = map_key ":" expression ;
map_key       = expression | "timeout" ;   (* 'timeout' is a contextual word here *)

for_expr = "for" "(" for_var "in" expression ")" yield_block ;
parallel_for_expr = "parallel" "for" "(" for_var "in" expression
                    "," "concurrency" ":" INT_LITERAL
                    "," "on_error" ":" IDENTIFIER ")" yield_block ;
yield_block = "{" stmt_list yield_stmt stmt_list "}" ;  (* grammar guarantees >= 1 yield *)

lambda_expr = "(" [ name { "," name } ] ")" "->" expression ;

foreign_code_expr = "foreign" "code" code_language
                    "(" code_inputs_opt ")" "->" code_output_contract
                    "{" code_source "}" ;
code_language = name | STRING_LITERAL ;   (* normalized to python3 *)

code_inputs_opt = [ code_input_seq trailing_comma_opt ] ;
code_input_seq  = code_input { "," code_input } ;
code_input      = code_type_ref name "=" expression ;

code_output_contract = code_direct_output | code_structural_output ;
code_direct_output   = code_type_ref ;
code_structural_output = "{" code_output_field code_output_field code_output_field_tail "}" ;
code_output_field_tail = { code_output_field } ;
code_output_field = name ":" code_type_ref ";" ;

code_source = "source" TEMPLATE_STRING ";" ;
code_type_ref = type_ref ;

trailing_comma_opt = [ "," ] ;
semicolon_opt      = [ ";" ] ;

(* ── Static semantic restrictions (part of the contract) ────────────────── *)

(*
 * - @mode is restricted to workflow, advanced-chat, or agent.
 * - @conversation declarations require advanced-chat mode; defaults must be
 *   target-representable typed literals.
 * - agent_application requires @mode agent; allowed keys are model (required),
 *   instruction, strategy, max_iteration, memory, memory_window, tools,
 *   knowledge { dataset_ids: [string], top_k: int }; unknown keys and type
 *   mismatches are compile errors.
 * - Programs have exactly one workflow entry named main.
 * - User workflow/code function call graphs are acyclic.
 * - while limit and parallel-for concurrency are positive static integers;
 *   parallel-for option names are concurrency and on_error; the on_error value
 *   is terminate, keep_null, or remove_failed.
 * - Named parallel branches have unique names; branch labels are source-level
 *   only (semantically ignored); parallel is a transparent barrier and never
 *   yields a collection value (no `let x = parallel {...}`).
 * - for_expr / parallel_for_expr bodies require at least one yield on every
 *   NORMAL path (paths that exit early are exempt) and the yield must be the
 *   last statement(s) of the body. `return` cannot exit a value-producing
 *   for (E1043: a function-level exit would break the aggregation).
 *   `break`/`continue` are legal in a for_expr (early exit; excluded from the
 *   yield requirement), while inside a parallel_for body both `break` and a
 *   value-carrying `return <v>` are E1037 (scheduler-dependent external
 *   exit) and `continue` stays legal.
 * - parallel-for iteration bodies are ITERATION-LOCAL scopes: a write to an
 *   outer name never escapes the loop (dead writes are legal), reads inside
 *   the iteration see that iteration's write, and a read of an
 *   iteration-written name AFTER the loop is E1036. `yield`/`continue` are
 *   iteration-local; `break` and value-carrying `return <v>` are E1037;
 *   a void `return;` is legal (it selects no value, so the outcome is
 *   deterministic).
 * - let bindings are immutable. var assignment is legal only for statically
 *   proven target-owned state (Loop state, advanced-chat conversation state);
 *   ordinary workflow mutation is rejected.
 * - =, +=, -=, *=, /= and << have one language meaning each; whether a
 *   particular operand/store shape can be lowered is a target-capability
 *   question and never introduces assigner/node-version syntax.
 * - output(expr) publishes one intermediate message to the response stream
 *   (non-terminating; model docs/NCODA-OUTPUT-MODEL.md). It is an ordinary
 *   statement: its POSITION is not part of its semantics (legal in any block
 *   or branch arm; rejected outside workflow/advanced-chat main and inside a
 *   parallel branch). A TEMPLATE_STRING operand is the message template and
 *   its interpolations become the target's named bindings.
 *   return is the function/workflow exit and the structured result.
 *   answer(...) statement is REMOVED (2026-08-23) and the @answer declaration
 *   is REMOVED (2026-09-16, W1 D4). The platform's useAnswerContent exit
 *   endpoint IS an OutputEmitter at runtime (the same object an output node is),
 *   but that is a PLATFORM fact, not a licence to carry that endpoint with the
 *   output construct: the endpoint decides the flow's ANSWER VALUE and is
 *   carried by `return template ...` (W2 §4, W1 D6), while `output` is the
 *   intermediate-message statement and has NO value relation to the exit node.
 * - output never contributes to the workflow exit value: the exit is decided by
 *   `return` alone (W1 D6, 2026-09-17). A flow whose only statement is
 *   `output(...)` exits with no result binding, and the exit node's bindings
 *   never reference an output node.
 * - return may be void (`return;`: the exit carries no result binding) or
 *   carry a value, and a carried value must be NAMED: either a map/record
 *   literal (`return { name: value, ... }`) or a record-typed expression whose
 *   exit names are that record's field names (sugar: `return r;` ==
 *   `return { f: r.f, ... }`). A scalar expression (`return u;`) is an error:
 *   the exit key is the workflow's output contract, so it is never inferred
 *   from the expression's producer port — a target that needs a key would
 *   otherwise silently rename the contract.
 * - `return template "<verbatim>" [using { slot: path, ... }];`
 *   (template_return) is the flow ANSWER endpoint; it is the third return
 *   shape next to the void exit and the value exit, and it selects no
 *   variable value (the answer text is the template, the named slots are that
 *   endpoint's bindings). Its restrictions:
 *     · the template operand is a literal and is carried verbatim: the
 *       compiler never parses the template text, never relates placeholders
 *       to slot names, and never reports a mismatch between them;
 *     · slot values are value paths (E1060 otherwise); slot names are
 *       target names and are carried verbatim in source order;
 *     · a template return is legal only at a FLOW EXIT position — the flow's
 *       top level, or inside an if / switch / parallel arm. Inside a loop
 *       body, inside a subfunction, or inside a QA action / attempt arm it is
 *       E1057 (none of those is the flow exit);
 *     · a flow may not mix `return template` with `return <value>` (E1058):
 *       the endpoint has one channel and the value exit is a different one.
 *       A void `return;` may coexist with it;
 *     · every template return of one flow must have the SAME identity —
 *       identical template text and identical ordered slot table (same names,
 *       same values) — because the target has exactly one answer node: any
 *       difference is E1059. Identical ones synthesise ONE answer endpoint.
 * - attempt and postfix operation policies apply only to manifest-declared
 *   workflow operations that expose the required physical Dify fields/handles.
 * - Call type arguments are accepted only by schema-dependent operations
 *   (current: extract<T>, exactly one named non-empty record).
 * - Extraction reports soft failure through .ok / .reason; attempt handles
 *   physical operation failure. Callers must inspect .ok before .value.
 * - foreign code language normalizes to python3 only; Code input/output types
 *   reject file, void, any, null, function, maps with non-string keys, and
 *   unrepresentable nested shapes; structural outputs declare >= 2 unique
 *   fields; a direct output creates one physical port named result; a Code
 *   body contains exactly one source member.
 * - ?? selects the first non-null operand and is lower-precedence than || / &&
 *   and higher than the ternary. It may not be mixed with || or && in one
 *   unparenthesized expression (`a || b ?? c`, `a ?? b && c` are syntax
 *   errors; parenthesize to disambiguate). When the left operand's type is
 *   statically non-optional the right operand is never taken (W2012).
 * - == / != between different types are accepted with warning W2011 (real
 *   platform workflows compare bool with string and stay runnable); the
 *   ordering comparisons < <= > >= stay strict type errors.
 * - int(...) and file(...) are the only conversions spelled as a type keyword
 *   (cast_expr); every other type keyword is a plain type. int → float is an
 *   implicit widening and needs no conversion.
 * - A name colliding with a reserved word or a type name is written with the
 *   `$` escape (ESCAPED_IDENTIFIER), e.g. `function main(file $file)`.
 * - Only explicit parallel and parallel-for introduce operation concurrency.
 * - Legal syntax is still subject to target capability classification; a
 *   REJECTED shape returns a diagnostic before WorkflowAST/YAML emission.
 *)

(* ── Canonical surface example (from LANGUAGE-REFERENCE §1, §4, §5) ─────── *)

(*
 *   @mode workflow
 *   code decorate(string value) -> string {
 *       return "[" + value + "]";
 *   }
 *
 *   function main(string input) -> string {
 *       let value = foreign code python3(string input = input) -> string {
 *           source `def main(input: str) -> dict:
 *       return {"result": input}`;
 *       };
 *       let items = for (item in [value]) { yield decorate(item); };
 *       output(items);
 *       return items[0];
 *   }
 *
 *   type TravelRequest = {
 *       string city;
 *       float days;
 *       bool flexible;
 *       string[] tags;
 *   }
 *
 *   function extract_city(string text) -> string {
 *       let extracted = extract<TravelRequest>("provider/model", text, {
 *           instruction: "Extract a travel request",
 *           descriptions: { city: "Destination city", days: "Duration" },
 *           strategy: "prompt"
 *       });
 *       if (!extracted.ok) { return extracted.reason; }
 *       return extracted.value.city;
 *   }
 *
 *   @mode agent
 *   @agent {
 *       model: "provider/model",
 *       instruction: "system persona",
 *       max_iteration: 10,
 *       tools: ["weather"],
 *   }
 *   function main(string query) -> string {
 *       return run(query);
 *   }
 *)
