@language nodecoda/1
@mode workflow

type TravelRequest = {
    string city;
    float days;
    bool flexible;
    string[] tags;
}

const MODEL = "openai_api_compatible/gpt-5.4";

function main(string text) {
    let extracted = extract<TravelRequest>(MODEL, text, {
        instruction: "Extract a travel request",
        descriptions: {
            city: "Destination city",
            days: "Trip duration in days",
            flexible: "Whether travel dates are flexible",
            tags: "Travel preferences"
        },
        strategy: "prompt"
    });

    if (!extracted.ok) {
        return extracted.reason;
    }

    // Only the successful branch reads the structured value ports.
    output("ok", extracted.ok);
    output("reason", extracted.reason);
    output("city", extracted.value.city);
    output("days", extracted.value.days);
}
