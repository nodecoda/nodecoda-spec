@language nodecoda/1
// Runtime evidence fixture: isolated named branches and a real fan-in consumer.

@mode workflow

function main(string seed = "probe") -> string {
    let values = parallel {
        left: {
            let result = foreign code python3(string seed = seed) -> string {
                source `def main(seed: str) -> dict:
    return {"result": f"left:{seed}"}`;
            };
            yield result;
        }
        right: {
            let result = foreign code python3(string seed = seed) -> string {
                source `def main(seed: str) -> dict:
    return {"result": f"right:{seed}"}`;
            };
            yield result;
        }
    };

    let joined = foreign code python3(
        string left = values.left,
        string right = values.right
    ) -> string {
        source `def main(left: str, right: str) -> dict:
    return {"result": f"{left}|{right}"}`;
    };
    return joined;
}
