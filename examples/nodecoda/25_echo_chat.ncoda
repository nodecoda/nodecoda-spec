@language nodecoda/1
// 25_echo_chat.ncoda
// Dify YAML: examples/yaml/echo-chat.yml
//
// Flow: Start(input) → Answer(echo:{{sys.query}})
// Pattern: advanced-chat echo bot
// NOTE: In DC, query parameter maps to sys.query at runtime

@mode advanced-chat

function main(string input) {
    return `echo:${input}`;
}
